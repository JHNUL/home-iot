{
    "name": "homeserver-ui",
    "private": true,
    "version": "0.1.1-SNAPSHOT",
    "type": "module",
    "scripts": {
        "build": "tsc -b && vite build",
        "dev": "vite",
        "format:check": "prettier --check .",
        "format": "prettier --write .",
        "lint:fix": "eslint --fix .",
